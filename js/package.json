{
  "name": "unixsr",
  "version": "0.0.7",
  "description": "USR: Unix Style Request — Axios with a Unix vocabulary HTTP client",
  "keywords": [
    "http",
    "client",
    "axios",
    "unix",
    "fetch"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kingjethro999/usr.git",
    "directory": "js"
  },
  "homepage": "https://github.com/kingjethro999/usr#readme",
  "bugs": {
    "url": "https://github.com/kingjethro999/usr/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc && node build/fix-extensions.cjs && node build/cjs.cjs",
    "pretest": "npm run build",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.0.0",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=20"
  }
}
